# Build artifacts
_build
__pycache__/
*.pyc
*.egg-info/
*_version.py
.pytest_cache/

# venv / uv
.venv/
uv.lock

# Notebook artifacts (we never commit .ipynb — only MyST .md)
*.ipynb
.ipynb_checkpoints/

# Benchmark output (R6 pytest-benchmark suite writes here)
benchmarks/results.json

# =============================================================================
# Reference cache (post-R2 catalog layout, 2026-05-17)
# Per-model catalog: tuningfork/catalog/<model>/{groundtruth.json,
# reference/<artifacts>.json, _cache/<gitignored>}.
# =============================================================================

# Reference draws — large; gitignored. Live under <model>/_cache/draws.npz.
tuningfork/catalog/*/_cache/draws.npz

# Per-step chain_stats from NUTS cert runs — diagnostic-only, ~1–2 MB per
# model. Written on every cert run (incl. failed runs, for statistician
# inspection). See worklog/decisions/2026-05-11-phase0-reference-protocol-
# refinements.md § 3.
tuningfork/catalog/*/_cache/chain_stats.npz

# Warmup checkpoints — workflow artifact written by certify_reference_nuts
# immediately after warmup. Enables resume-after-crash via ``pre_adapted=...``
# and forensic inspection of bad warmups. State pkl is ~O(d) bytes; warmup_info
# npz is ~O(n_warmup * 8) bytes per field. See certify_reference.py
# WarmupCheckpoint class for the layout. Introduced 2026-05-14.
tuningfork/catalog/*/_cache/warmup_checkpoint/

# Failed-cert artifacts — diagnostic-only, never gate-bearing. Persisted by
# ``get_reference_draws`` on the CertificationError path so the statistician
# can do cluster-in-parameter-space analysis (Lens 1 of the diagnostics
# playbook) without re-running. Distinct filenames from the success-path
# artifacts so a failed re-run never overwrites a previous successful cert.
tuningfork/catalog/*/reference/adaptation.failed.json

# =============================================================================
# Legacy reference-cache patterns (pre-R2, 2026-05-17). Kept so existing
# local cache from prior layouts stays ignored as users transition.
# _io.py no longer reads/writes these paths — they're orphan-on-disk only.
# =============================================================================

# Pre-R2 per-model reference layout (post-cleanup-and-simplify, PR #6):
tuningfork/reference/*/draws.npz
tuningfork/reference/*/chain_stats.npz
tuningfork/reference/*/warmup_checkpoint/
tuningfork/reference/*/adaptation.failed.json

# Pre-cleanup-and-simplify per-type layout (legacy-legacy):
tuningfork/reference/draws/*.npz
tuningfork/reference/draws/*.npy
tuningfork/reference/chain_stats/*.npz
tuningfork/reference/warmup_checkpoint/

# OS / editor
.DS_Store
*.bak
.vscode/
.idea/

# Local-only Claude scratchpads
CLAUDE.md.local

# Per-user-device agent transcripts and consolidated timelines.
# Lives at ../.agent_logs/ (parent dir, outside this repo) — these patterns
# defend against future structural changes that move .agent_logs/ inside.
.agent_logs/
