# === SAMPLER: rwm (Random-Walk Metropolis with isotropic Gaussian proposal) ===
# Wraps blackjax.rmh with an isotropic Gaussian proposal in flat parameter
# space, un-ravelled back to the pytree structure (mirrors
# tuningfork.base_method.rwm._make_rwm).
from jax.flatten_util import ravel_pytree as _ravel_pytree

_flat_init, _ = _ravel_pytree(init_position)
_default_step_size = $bm_sigma


def _build_kernel(step_size, inverse_mass_matrix):  # noqa: ARG001
    # RWM uses an isotropic Gaussian proposal scaled by step_size; IMM arg is
    # present for protocol compatibility with inference_loop.py.tmpl.
    def _proposal(rng_key, position):
        flat, unravel = _ravel_pytree(position)
        noise = jax.random.normal(rng_key, shape=flat.shape) * step_size
        return unravel(flat + noise)

    return blackjax.rmh(logdensity_fn, proposal_generator=_proposal).step


# kernel_builder is the protocol expected by inference_loop.py.tmpl.
kernel_builder = _build_kernel


def _default_rwm_proposal(rng_key, position):
    flat, unravel = _ravel_pytree(position)
    return unravel(flat + jax.random.normal(rng_key, shape=flat.shape) * _default_step_size)


try:
    _state_post_warmup
except NameError:
    _warmup_init_is_single_chain = True
    _state_post_warmup = blackjax.rmh(
        logdensity_fn, proposal_generator=_default_rwm_proposal
    ).init(init_position)
