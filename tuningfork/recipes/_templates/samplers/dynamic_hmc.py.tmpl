# === SAMPLER: dynamic_hmc (step_size + IMM from warmup; trajectory length auto-tuned via random_generator_arg) ===
# dynamic_hmc.init requires a rng_key as random_generator_arg so that
# next_random_arg_fn can produce a valid JAX key on every step.
# DynamicHMCState has an additional random_generator_arg field not present in
# HMCState / NUTSState, so we always re-init inside the per-chain vmap.
from jax.flatten_util import ravel_pytree as _ravel_pytree

_flat_init, _ = _ravel_pytree(init_position)
_n_params = int(_flat_init.shape[0])

_default_step_size = $bm_step_size
_default_imm = jnp.ones(_n_params)


def _build_kernel(step_size, inverse_mass_matrix):
    return blackjax.dynamic_hmc(
        logdensity_fn,
        step_size=step_size,
        inverse_mass_matrix=inverse_mass_matrix,
    ).step


# kernel_builder is the protocol expected by inference_loop.py.tmpl.
kernel_builder = _build_kernel


def _state_reinit(step_size, inverse_mass_matrix, position, rng_key):
    """Re-init per-chain DynamicHMCState from (position, rng_key).

    Called inside inference_loop.py.tmpl's per-chain vmap when _state_reinit
    is defined. The rng_key seeds random_generator_arg in DynamicHMCState.
    """
    return blackjax.dynamic_hmc(
        logdensity_fn,
        step_size=step_size,
        inverse_mass_matrix=inverse_mass_matrix,
    ).init(position, rng_key)


# _state_post_warmup: window_adaptation warmup produces NUTSState; dynamic_hmc
# requires DynamicHMCState. The _state_reinit function handles per-chain
# re-init inside the inference loop vmap. We still need a valid _state_post_warmup
# so inference_loop.py.tmpl can pass its .position to _state_reinit.
try:
    _state_post_warmup
except NameError:
    # no_warmup path: initialise a placeholder NUTSState from init_position.
    # _state_reinit will replace it per-chain inside the vmap.
    _warmup_init_is_single_chain = True
    _state_post_warmup = blackjax.nuts(
        logdensity_fn,
        step_size=_default_step_size,
        inverse_mass_matrix=_default_imm,
    ).init(init_position)
