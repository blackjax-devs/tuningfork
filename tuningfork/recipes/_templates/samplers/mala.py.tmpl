# === SAMPLER: mala (Metropolis-Adjusted Langevin; step_size only, no mass matrix) ===
_default_step_size = $bm_step_size


def _build_kernel(step_size, inverse_mass_matrix):  # noqa: ARG001
    # MALA does not use inverse_mass_matrix; IMM arg present for protocol
    # compatibility with the kernel_builder interface in inference_loop.py.tmpl.
    return blackjax.mala(logdensity_fn, step_size=step_size).step


# kernel_builder is the protocol expected by inference_loop.py.tmpl.
kernel_builder = _build_kernel

# Bind _state_post_warmup: warmup template sets it when adaptation runs;
# for no_warmup we initialize from init_position here.
try:
    _state_post_warmup
except NameError:
    _warmup_init_is_single_chain = True
    _state_post_warmup = blackjax.mala(
        logdensity_fn, step_size=_default_step_size
    ).init(init_position)
