# === SAMPLER: mala (Metropolis-Adjusted Langevin; step_size only, no mass matrix) ===
_step_size = _adapted_params.get("step_size", $bm_step_size)

_kernel_obj = blackjax.mala(logdensity_fn, step_size=_step_size)
kernel = _kernel_obj.step

# Bind _state_post_warmup: warmup template sets it when adaptation runs;
# for no_warmup we initialize from init_position here.
try:
    _state_post_warmup
except NameError:
    _state_post_warmup = _kernel_obj.init(init_position)
