# === SAMPLER: laplace_hmc (Laplace-marginalised HMC on phi-space) ===
# log_joint_fn and theta_init come from the laplace_preamble section above.
# D8: no logdensity_fn reference — laplace_hmc uses log_joint_fn directly.
from jax.flatten_util import ravel_pytree as _ravel_pytree

_flat_phi_init, _ = _ravel_pytree(init_position)
_n_phi = int(_flat_phi_init.shape[0])

_num_steps = $bm_num_integration_steps
_maxiter = $bm_maxiter
_default_step_size = $bm_step_size
_default_imm = jnp.ones(_n_phi)


def _build_kernel(step_size, inverse_mass_matrix):
    return blackjax.laplace_hmc(
        log_joint_fn,
        theta_init,
        step_size=step_size,
        inverse_mass_matrix=inverse_mass_matrix,
        num_integration_steps=_num_steps,
        maxiter=_maxiter,
    ).step


# kernel_builder is the protocol expected by inference_loop.py.tmpl.
# The warmup (window_adaptation + blackjax.laplace_hmc inner kernel) produces
# LaplaceHMCState, which is compatible with laplace_hmc.step — no _state_reinit needed.
kernel_builder = _build_kernel

try:
    _state_post_warmup
except NameError:
    # no_warmup path: build initial LaplaceHMCState from phi_init via cold L-BFGS.
    _warmup_init_is_single_chain = True
    _state_post_warmup = blackjax.laplace_hmc(
        log_joint_fn,
        theta_init,
        step_size=_default_step_size,
        inverse_mass_matrix=_default_imm,
        num_integration_steps=_num_steps,
        maxiter=_maxiter,
    ).init(init_position)
