# === SAMPLER: barker (Barker proposal; step_size + IMM per-chain from warmup) ===
from jax.flatten_util import ravel_pytree as _ravel_pytree

_flat_init, _ = _ravel_pytree(init_position)
_n_params = int(_flat_init.shape[0])

_default_step_size = $bm_step_size
_default_imm = jnp.ones(_n_params)


def _build_kernel(step_size, inverse_mass_matrix):
    return blackjax.barker(
        logdensity_fn,
        step_size=step_size,
        inverse_mass_matrix=inverse_mass_matrix,
    ).step


# kernel_builder is the protocol expected by inference_loop.py.tmpl when
# _adapted_params is multi-chain: each chain builds its own kernel from its
# own adapted step_size and inverse_mass_matrix.
kernel_builder = _build_kernel

try:
    _state_post_warmup
except NameError:
    _warmup_init_is_single_chain = True
    _state_post_warmup = blackjax.barker(
        logdensity_fn,
        step_size=_default_step_size,
        inverse_mass_matrix=_default_imm,
    ).init(init_position)
