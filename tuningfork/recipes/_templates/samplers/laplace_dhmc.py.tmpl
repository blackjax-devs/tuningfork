# === SAMPLER: laplace_dhmc (Laplace-marginalised dynamic HMC on phi-space) ===
# log_joint_fn and theta_init come from the laplace_preamble section above.
# D8: no logdensity_fn reference — laplace_dhmc uses log_joint_fn directly.
# Dynamic variant: uses a quasi-random integration-step schedule via
# random_generator_arg (Halton index). LaplaceDynamicHMCState carries both
# theta_star and random_generator_arg; _state_reinit is required.
from jax.flatten_util import ravel_pytree as _ravel_pytree

_flat_phi_init, _ = _ravel_pytree(init_position)
_n_phi = int(_flat_phi_init.shape[0])

_optimizer_kwargs = $bm_optimizer_kwargs_expr
_default_step_size = $bm_step_size
_default_imm = jnp.ones(_n_phi)


def _build_kernel(step_size, inverse_mass_matrix):
    return blackjax.laplace_dhmc(
        log_joint_fn,
        theta_init,
        step_size=step_size,
        inverse_mass_matrix=inverse_mass_matrix,
        **_optimizer_kwargs,
    ).step


# kernel_builder is the protocol expected by inference_loop.py.tmpl.
kernel_builder = _build_kernel


def _state_reinit(step_size, inverse_mass_matrix, position, rng_key):
    """Re-init per-chain LaplaceDynamicHMCState from (position, rng_key).

    Called inside inference_loop.py.tmpl's per-chain vmap when _state_reinit
    is defined. The rng_key seeds random_generator_arg in LaplaceDynamicHMCState.
    The warmup produces LaplaceHMCState (laplace_hmc inner kernel); laplace_dhmc
    requires LaplaceDynamicHMCState. _state_reinit bridges the gap.
    """
    return blackjax.laplace_dhmc(
        log_joint_fn,
        theta_init,
        step_size=step_size,
        inverse_mass_matrix=inverse_mass_matrix,
        **_optimizer_kwargs,
    ).init(position, rng_key)


try:
    _state_post_warmup
except NameError:
    # no_warmup path: placeholder state; _state_reinit handles per-chain init.
    _warmup_init_is_single_chain = True
    _state_post_warmup = blackjax.laplace_hmc(
        log_joint_fn,
        theta_init,
        step_size=_default_step_size,
        inverse_mass_matrix=_default_imm,
        num_integration_steps=10,
        **_optimizer_kwargs,
    ).init(init_position)
