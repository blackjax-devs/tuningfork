# === WARMUP: window_adaptation_low_rank_imm multi-chain (max_rank=$wp_max_rank, target_acceptance_rate=$target_acceptance_rate, n_warmup=$n_warmup) ===
# Multi-chain warmup: jax.vmap over window_adaptation_low_rank.run so each chain
# gets its own adapted (step_size, inverse_mass_matrix).  Requires progress_bar=False
# because io_callback (progress_bar) is not supported inside jax.vmap.
# This matches the runner's per-chain warmup behavior.
_warmup = blackjax.window_adaptation_low_rank(
    $warmup_algorithm,
    logdensity_fn,
    max_rank=$wp_max_rank,
    target_acceptance_rate=$target_acceptance_rate$warmup_extra_kwargs,
    progress_bar=False,
)
_warmup_keys = jax.random.split(jax.random.key($tuning_seed), num_chains)
# Replicate init_position to (num_chains, ...) for vmap.
_init_positions = jax.tree.map(
    lambda x: jnp.broadcast_to(x[None], (num_chains,) + x.shape), init_position
)


@jax.vmap
def _run_one_warmup(k, x0):
    (state, params), _ = _warmup.run(k, x0, $n_warmup)
    return state, params


_batched_states, _adapted_params = _run_one_warmup(_warmup_keys, _init_positions)
# _warmup_is_perchain=True: adapted params have a leading num_chains axis.
_warmup_is_perchain = True
_state_post_warmup = _batched_states
# After warmup:
#   _state_post_warmup       -- batched state with leading num_chains axis
#   _adapted_params["step_size"]              shape (num_chains,) [per-chain]
#   _adapted_params["inverse_mass_matrix"]    LowRankInverseMassMatrix (batched, num_chains leading axis)
