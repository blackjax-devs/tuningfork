# === WARMUP: laplace multi-phase ($num_warmup_phases phases) ===
# Phase 1: $wp0_name (n_warmup=$wp0_n_warmup, target=$wp0_target$wp0_extra_kwargs)
# Phase 2: $wp1_name (n_warmup=$wp1_n_warmup, target=$wp1_target$wp1_extra_kwargs)
# Inner kernel for both phases: $warmup_algorithm
#
# Each phase uses a separate LaplaceMarginal factory (different maxiter).
# The logdensity_fn override ensures each phase's window_adaptation sees the
# correct LaplaceMarginal with the right L-BFGS iteration budget.
#
# Single-chain warmup: both phases run on one chain; the final state is
# broadcast to (num_chains,) for scan(vmap(kernel)) in the inference loop.
# Running warmup inside vmap is discouraged because io_callback (progress_bar)
# is not supported inside vmap.

# ── Phase 1: traversal (diagonal IMM) ────────────────────────────────────────
# Phase 1 logdensity_fn: _laplace_warmup[0] (already set by laplace_preamble)
_warmup_p1 = blackjax.window_adaptation(
    $warmup_algorithm,
    logdensity_fn,
    target_acceptance_rate=$wp0_target$wp0_extra_kwargs,
    progress_bar=True,
)
_warmup_key_p1 = jax.random.fold_in(jax.random.key($tuning_seed), 0)
(state_phase1, _adapted_params_phase1), _ = _warmup_p1.run(
    _warmup_key_p1, init_position, $wp0_n_warmup
)
# After Phase 1 (single chain):
#   state_phase1   — LaplaceHMCState with phi + theta_star
#   _adapted_params_phase1["step_size"]             scalar — from dual-avg
#   _adapted_params_phase1["inverse_mass_matrix"]   shape (phi_dim,) [diag]

# ── Phase 2: Welford dense IMM capture ───────────────────────────────────────
# Switch to Phase 2 LaplaceMarginal (higher maxiter for accurate Hessians).
logdensity_fn = _laplace_warmup[1]
# Seed Phase 2 dual-averaging at Phase 1's adapted step_size (scalar — single chain).
_initial_step_size_p2 = float(_adapted_params_phase1["step_size"])
_warmup_p2 = blackjax.window_adaptation(
    $warmup_algorithm,
    logdensity_fn,
    is_mass_matrix_diagonal=False,
    target_acceptance_rate=$wp1_target$wp1_extra_kwargs,
    initial_step_size=_initial_step_size_p2,
    progress_bar=True,
)
# Use key offset from Phase 1 to avoid correlation.
_warmup_key_p2 = jax.random.fold_in(jax.random.key($tuning_seed + 1), 0)
# Phase 2 starts from Phase 1 end-position (single chain phi; warm-started theta_star).
_init_position_p2 = state_phase1.position
(state_post_warmup_single, _adapted_params), _ = _warmup_p2.run(
    _warmup_key_p2, _init_position_p2, $wp1_n_warmup
)
# Broadcast final state to (num_chains,) for scan(vmap(kernel)).
_state_post_warmup = jax.tree.map(
    lambda x: jnp.broadcast_to(x[None], (num_chains,) + x.shape),
    state_post_warmup_single,
)
# After Phase 2 (final adapted params — used by inference loop):
#   _state_post_warmup  — LaplaceHMCState with accurate theta_star (maxiter=$wp1_maxiter)
#                         broadcast to (num_chains,) leading axis
#   _adapted_params["step_size"]             scalar (shared across chains)
#   _adapted_params["inverse_mass_matrix"]   shape (phi_dim, phi_dim) [dense]
