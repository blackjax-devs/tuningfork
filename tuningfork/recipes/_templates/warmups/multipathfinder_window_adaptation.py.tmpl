# === WARMUP: multipathfinder_window_adaptation
#   n_paths=$wp_n_paths, num_samples_per_path=$wp_num_samples_per_path,
#   imm_shrinkage_to_previous=$wp_imm_shrinkage_to_previous,
#   target_acceptance_rate=$target_acceptance_rate, n_warmup=$n_warmup ===

# Stage 1: multipathfinder — derive dense (d,d) IMM via PSIS-weighted
# L-BFGS mixture covariance (law of total variance) and resample init positions.
import jax.numpy as jnp
from blackjax.optimizers.lbfgs import lbfgs_inverse_hessian_formula_1
from blackjax.vi.multipathfinder import psis_weights
from jax.flatten_util import ravel_pytree

_n_paths = $wp_n_paths
_num_samples_per_path = $wp_num_samples_per_path

_pf_key, _resample_key, _adapt_key = jax.random.split(jax.random.key($tuning_seed), 3)

# Replicate init_position to (n_paths, ...) for the multi-path fit.
_init_positions_mpf = jax.tree.map(
    lambda x: jnp.broadcast_to(x[None], (_n_paths,) + x.shape), init_position
)

_mpf = blackjax.multipathfinder(logdensity_fn)
_mpf_state, _ = _mpf.init(_pf_key, _init_positions_mpf, num_samples=_num_samples_per_path)

_log_weights, _pareto_k = psis_weights(_mpf_state)

# Compute PSIS-weighted mixture covariance (law of total variance).
# NOTE: we flatten positions via ravel_pytree because PathfinderState.position
# stores the pytree-structured form, not a flat (n_paths, d) array.
_n_paths_actual = _log_weights.shape[0] // _num_samples_per_path
_log_w_per_path = _log_weights.reshape(_n_paths_actual, _num_samples_per_path)
_log_w_path_norm = jax.scipy.special.logsumexp(_log_w_per_path, axis=1)
_log_w_path_norm -= jax.scipy.special.logsumexp(_log_w_path_norm)
_w = jnp.exp(_log_w_path_norm)  # (n_paths,)
_mu_per_path = jax.vmap(lambda x: ravel_pytree(x)[0])(_mpf_state.path_states.position)  # (n_paths, d)
_sigmas = jax.vmap(lbfgs_inverse_hessian_formula_1)(
    _mpf_state.path_states.alpha,
    _mpf_state.path_states.beta,
    _mpf_state.path_states.gamma,
)  # (n_paths, d, d)
_mu_mix = jnp.einsum("i,id->d", _w, _mu_per_path)
_sigma_within = jnp.einsum("i,ijk->jk", _w, _sigmas)
_delta = _mu_per_path - _mu_mix[None, :]
_sigma_between = jnp.einsum("i,ij,ik->jk", _w, _delta, _delta)
_imm_dense = _sigma_within + _sigma_between  # (d, d)

# PSIS-resample num_chains init positions (used later to broadcast the state).
_samples_flat = jax.tree.map(
    lambda x: x.reshape(-1, *x.shape[2:]), _mpf_state.samples
)
_probs = jnp.exp(_log_weights)
_init_indices = jax.random.choice(
    _resample_key, _log_weights.shape[0], shape=(num_chains,), replace=True, p=_probs
)
_init_positions_psis = jax.tree.map(lambda x: x[_init_indices], _samples_flat)
# _init_positions_psis: shape (num_chains, ...) — PSIS-resampled starting points.
# Use the first resampled position as the single-chain warmup starting point.
_init_position_pf = jax.tree.map(lambda x: x[0], _init_positions_psis)

# Stage 2: single-chain window_adaptation seeded with multipathfinder IMM.
# Single-chain warmup avoids io_callback-in-vmap issue (progress_bar).
# imm_shrinkage_to_previous keeps the multipathfinder IMM influential across windows.
_warmup = blackjax.window_adaptation(
    blackjax.nuts,
    logdensity_fn,
    is_mass_matrix_diagonal=False,
    initial_inverse_mass_matrix=_imm_dense,
    imm_shrinkage_to_previous=$wp_imm_shrinkage_to_previous,
    target_acceptance_rate=$target_acceptance_rate,
    initial_step_size=1.0,
    progress_bar=True,
)

_warmup_key = jax.random.fold_in(_adapt_key, 0)
(state, _adapted_params), _ = _warmup.run(_warmup_key, _init_position_pf, $n_warmup)
# Broadcast state to (num_chains,) using PSIS-resampled positions as chain start points.
# Each chain starts at a different PSIS-resampled position but shares adapted params.
_state_post_warmup = jax.tree.map(
    lambda x: jnp.broadcast_to(x[None], (num_chains,) + x.shape),
    state,
)
# _adapted_params["step_size"]: scalar (shared across chains)
# _adapted_params["inverse_mass_matrix"]: (d, d)
# _pareto_k: scalar PSIS Pareto-k diagnostic
