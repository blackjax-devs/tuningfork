# === WARMUP: $warmup_name (VI-based IMM + init-positions + adapted step_size) ===
# Phase 1: single VI optimisation ($wp_num_optimization_steps Adam steps),
#           shared across all chains.  Extracts IMM and draws num_chains init positions.
# Phase 2: step_size-only dual-averaging adaptation ($n_warmup steps from chain-0
#           VI-drawn position, VI IMM FROZEN).  Incremental Nesterov DA:
#           step_size updates each step; MCMC runs at the current step_size.
#           The frozen-IMM constraint is load-bearing: mass matrix is not touched
#           after VI fit.
# Compatible: nuts, hmc, mala, rwm, barker.  NOT compatible with mclmc.
import optax as ${vi_prefix}_optax
import $vi_module as ${vi_prefix}_vi
from blackjax.adaptation.step_size import dual_averaging_adaptation as ${vi_prefix}_da_adapt
from jax.flatten_util import ravel_pytree as ${vi_prefix}_ravel

${vi_prefix}_optimizer = ${vi_prefix}_optax.adam(1e-2)
${vi_prefix}_num_opt_steps = $wp_num_optimization_steps

${vi_prefix}_flat_init, ${vi_prefix}_unravel = ${vi_prefix}_ravel(init_position)
_d = int(${vi_prefix}_flat_init.shape[0])

# ── Phase 1: VI optimisation ─────────────────────────────────────────────────
${vi_prefix}_vi_key, ${vi_prefix}_sample_key, ${vi_prefix}_sa_key = jax.random.split(
    jax.random.key($tuning_seed), 3
)
${vi_prefix}_vi_init = ${vi_prefix}_vi.init(init_position, ${vi_prefix}_optimizer)


def ${vi_prefix}_vi_one_step(carry, step_key):
    new_state, info = ${vi_prefix}_vi.step(
        step_key, carry, logdensity_fn, ${vi_prefix}_optimizer, 5
    )
    return new_state, info


${vi_prefix}_vi_keys = jax.random.split(${vi_prefix}_vi_key, ${vi_prefix}_num_opt_steps)
${vi_prefix}_final_vi_state, _ = jax.lax.scan(
    ${vi_prefix}_vi_one_step, ${vi_prefix}_vi_init, ${vi_prefix}_vi_keys
)

# Extract IMM from fitted VI state ($vi_imm_description).
$vi_imm_extraction_block

# Draw num_chains init positions from the fitted distribution.
${vi_prefix}_chain_keys = jax.random.split(${vi_prefix}_sample_key, num_chains)


@jax.vmap
def ${vi_prefix}_draw_one(key):
    samples = ${vi_prefix}_vi.sample(key, ${vi_prefix}_final_vi_state, num_samples=1)
    pos = jax.tree.map(lambda x: x[0], samples)
    flat_pos, _ = ${vi_prefix}_ravel(pos)
    return flat_pos


${vi_prefix}_flat_positions = ${vi_prefix}_draw_one(${vi_prefix}_chain_keys)  # (num_chains, d)
${vi_prefix}_init_positions = jax.vmap(${vi_prefix}_unravel)(${vi_prefix}_flat_positions)

# ── Phase 2: incremental step_size dual-averaging (VI IMM frozen) ─────────────
${vi_prefix}_da_init_fn, ${vi_prefix}_da_update_fn, ${vi_prefix}_da_final_fn = ${vi_prefix}_da_adapt(
    target=$target_acceptance_rate
)
${vi_prefix}_da_s0 = ${vi_prefix}_da_init_fn(1.0)

${vi_prefix}_sa_init_state = $warmup_algorithm(
    logdensity_fn,
    step_size=1.0,
    inverse_mass_matrix=${vi_prefix}_imm$warmup_extra_kwargs,
).init(jax.tree.map(lambda x: x[0], ${vi_prefix}_init_positions))


def ${vi_prefix}_sa_one_step(carry, step_key):
    """One step of frozen-IMM incremental step_size dual-averaging."""
    mcmc_state, da_state = carry
    current_ss = jnp.exp(da_state.log_step_size)
    new_mcmc_state, mcmc_info = $warmup_algorithm(
        logdensity_fn,
        step_size=current_ss,
        inverse_mass_matrix=${vi_prefix}_imm$warmup_extra_kwargs,
    ).step(step_key, mcmc_state)
    _accept = jnp.asarray(
        getattr(
            mcmc_info,
            "acceptance_rate",
            getattr(mcmc_info, "is_accepted", jnp.asarray(0.5)),
        )
    )
    new_da_state = ${vi_prefix}_da_update_fn(da_state, jnp.mean(_accept))
    return (new_mcmc_state, new_da_state), None


${vi_prefix}_sa_keys = jax.random.split(${vi_prefix}_sa_key, $n_warmup)
(${vi_prefix}_sa_final_mcmc, ${vi_prefix}_sa_final_da), _ = jax.lax.scan(
    ${vi_prefix}_sa_one_step,
    (${vi_prefix}_sa_init_state, ${vi_prefix}_da_s0),
    ${vi_prefix}_sa_keys,
)
${vi_prefix}_adapted_step_size = ${vi_prefix}_da_final_fn(${vi_prefix}_sa_final_da)

# ── Build downstream kernel states (VI positions + adapted step_size + VI IMM) ─


@jax.vmap
def ${vi_prefix}_init_one(pos):
    return $warmup_algorithm(
        logdensity_fn,
        step_size=${vi_prefix}_adapted_step_size,
        inverse_mass_matrix=${vi_prefix}_imm$warmup_extra_kwargs,
    ).init(pos)


_state_post_warmup = ${vi_prefix}_init_one(${vi_prefix}_init_positions)

_adapted_params = {
    "step_size": jnp.full((num_chains,), ${vi_prefix}_adapted_step_size),
    "inverse_mass_matrix": $vi_adapted_imm_expr,
}
_warmup_is_perchain = True
