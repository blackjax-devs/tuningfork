# === WARMUP: multipathfinder (n_paths=$wp_n_paths, target_acceptance_rate=$target_acceptance_rate, n_warmup=$n_warmup) ===
# Multi-path Pathfinder + dual-averaging step size adaptation.
# Derives a shared dense (d,d) IMM from the PSIS-weighted L-BFGS mixture covariance;
# broadcasts to (num_chains, d, d).
import jax.numpy as jnp

_n_paths = $wp_n_paths

_mpf_adapt = blackjax.pathfinder_adaptation(
    blackjax.nuts,
    logdensity_fn,
    num_chains=num_chains,
    n_paths=_n_paths,
    num_samples_per_path=$wp_num_samples_per_path,
    imm_estimator="lbfgs_psis_mixture",
    initial_step_size=1.0,
    target_acceptance_rate=$target_acceptance_rate,
)
_mpf_results, _ = _mpf_adapt.run(jax.random.key($tuning_seed), init_position, $n_warmup)
_state_post_warmup = _mpf_results.state
_adapted_params = {
    "step_size": _mpf_results.parameters["step_size"],       # (num_chains,)
    "inverse_mass_matrix": jnp.broadcast_to(
        _mpf_results.parameters["inverse_mass_matrix"][None],
        (num_chains,) + _mpf_results.parameters["inverse_mass_matrix"].shape,
    ),  # (num_chains, d, d)
    "_multipathfinder_psis_pareto_k": _mpf_results.parameters.get(
        "_pathfinder_psis_pareto_k"
    ),
}
