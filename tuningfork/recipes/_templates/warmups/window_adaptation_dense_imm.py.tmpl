# === WARMUP: window_adaptation_dense_imm (target_acceptance_rate=$target_acceptance_rate, n_warmup=$n_warmup, dense IMM) ===
# Per-chain independent warmup via jax.vmap — each chain receives its own RNG key
# derived from the tuning_seed, matching the Stan/NumPyro convention and the
# tuningfork.warmup.window_adaptation_dense_imm.runner implementation.
# All chains share the same init_position (same point, independent trajectories).
_warmup = blackjax.window_adaptation(
    $warmup_algorithm,
    logdensity_fn,
    is_mass_matrix_diagonal=False,
    target_acceptance_rate=$target_acceptance_rate$warmup_extra_kwargs,
    progress_bar=False,
)
_warmup_keys = jax.random.split(jax.random.key($tuning_seed), num_chains)
_init_positions = jax.tree.map(
    lambda x: jnp.broadcast_to(x, (num_chains,) + x.shape),
    init_position,
)


def _run_one_warmup(key, init_pos):
    (state, params), _ = _warmup.run(key, init_pos, $n_warmup)
    return state, params


_state_post_warmup, _adapted_params = jax.vmap(_run_one_warmup)(
    _warmup_keys, _init_positions
)
# After vmap:
#   _state_post_warmup  — batched state with leading num_chains axis
#   _adapted_params["step_size"]              shape (num_chains,)
#   _adapted_params["inverse_mass_matrix"]    shape (num_chains, d, d) [dense]
