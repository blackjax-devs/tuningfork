# === WARMUP: window_adaptation_dense_imm (target_acceptance_rate=$target_acceptance_rate, n_warmup=$n_warmup, dense IMM) ===
# Single-chain warmup: run once and broadcast the state to (num_chains,) so that
# scan(vmap(kernel)) in the inference loop maps over chains sharing the same
# adapted (step_size, inverse_mass_matrix).  Running warmup inside vmap is
# discouraged because io_callback (progress_bar) is not supported inside vmap.
_warmup = blackjax.window_adaptation(
    $warmup_algorithm,
    logdensity_fn,
    is_mass_matrix_diagonal=False,
    target_acceptance_rate=$target_acceptance_rate$warmup_extra_kwargs,
    progress_bar=True,
)
_warmup_key = jax.random.fold_in(jax.random.key($tuning_seed), 0)
(state, _adapted_params), _ = _warmup.run(_warmup_key, init_position, $n_warmup)
# Broadcast state to (num_chains,) for scan(vmap(kernel)).
_state_post_warmup = jax.tree.map(
    lambda x: jnp.broadcast_to(x[None], (num_chains,) + x.shape),
    state,
)
# After warmup:
#   _state_post_warmup  — batched state with leading num_chains axis
#   _adapted_params["step_size"]              scalar (shared across chains)
#   _adapted_params["inverse_mass_matrix"]    shape (d, d) [dense]
