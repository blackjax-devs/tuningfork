_NUM_SAMPLES = $num_samples
_SAMPLING_PROGRESS_BAR = $sampling_progress_bar  # set False to disable terminal bar (one-line fallback)

# Ensure _state_post_warmup has a leading chain axis of size num_chains before
# the run_inference_algorithm(vmapped input) loop.  Warmup templates that run
# single-chain warmup and broadcast already set a (num_chains, ...) state.
# The no_warmup template sets _warmup_init_is_single_chain = True because the
# sampler template initialises from init_position (single chain).
try:
    _warmup_init_is_single_chain
except NameError:
    _warmup_init_is_single_chain = False

if _warmup_init_is_single_chain:
    _state_post_warmup = jax.tree.map(
        lambda x: jnp.broadcast_to(x[None], (num_chains,) + x.shape),
        _state_post_warmup,
    )
    # Scalar defaults for no-warmup path (samplers that don't use IMM ignore these).
    _shared_step_size = float(_adapted_params.get("step_size", 1.0))
    from jax.flatten_util import ravel_pytree as _il_ravel
    _il_flat, _ = _il_ravel(init_position)
    _n_dims = int(_il_flat.shape[0])
    _shared_imm = jnp.ones(_n_dims)
else:
    # Single-chain warmup path: adapted params are scalar / un-batched.
    _shared_step_size = _adapted_params["step_size"]
    _shared_imm = _adapted_params["inverse_mass_matrix"]

# Detect whether the sampler template declared _state_reinit (for samplers
# like dynamic_hmc / dmhmc / ghmc that require a different state type than
# what window_adaptation produces).
try:
    _state_reinit
    _needs_state_reinit = True
except NameError:
    _needs_state_reinit = False

# For samplers that need re-init (dynamic_hmc, dmhmc, ghmc): vmap-init each
# chain BEFORE run_inference_algorithm so the batched state has a homogeneous type.
if _needs_state_reinit:
    _reinit_keys = jax.random.split(jax.random.key($tuning_seed + 999), num_chains)
    _state_post_warmup = jax.vmap(
        lambda s, k: _state_reinit(_shared_step_size, _shared_imm, s.position, k)
    )(_state_post_warmup, _reinit_keys)

# Build ONE shared kernel (shared step_size + IMM across all chains).
_kernel = kernel_builder(_shared_step_size, _shared_imm)

# run_inference_algorithm with vmapped inputs — canonical multi-chain pattern.
# ONE kernel is built with shared adapted params; the step function vmaps over
# chains internally so run_inference_algorithm is NOT vmapped.
# Input: _state_post_warmup has shape (num_chains, ...) — already batched.
# Output: history is (num_steps, num_chains, ...) for all fields.
from blackjax.util import run_inference_algorithm as _run_inference_algorithm
from blackjax.base import SamplingAlgorithm as _SamplingAlgorithm


def _vmapped_step(rng_key, states):
    keys = jax.random.split(rng_key, num_chains)
    return jax.vmap(_kernel.step)(keys, states)


_alg = _SamplingAlgorithm(_kernel.init, _vmapped_step)

_final_state, (_states_hist, _infos_hist) = _run_inference_algorithm(
    jax.random.key($sampler_seed),
    _alg,
    num_steps=_NUM_SAMPLES,
    initial_state=_state_post_warmup,
    progress_bar=_SAMPLING_PROGRESS_BAR,
)

# Swap axes: (num_steps, num_chains, ...) → (num_chains, num_steps, ...).
# Consumers (postamble, shape checks) expect (num_chains, num_samples, ...).
_samples = jax.tree.map(lambda x: jnp.swapaxes(x, 0, 1), _states_hist)
_infos = jax.tree.map(lambda x: jnp.swapaxes(x, 0, 1), _infos_hist)
