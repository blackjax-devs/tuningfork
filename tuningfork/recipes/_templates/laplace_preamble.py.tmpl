# === LAPLACE: phi/theta split and LaplaceMarginal factories ===
# Model: $model_name — phi sites: $phi_sites_repr, theta sites: $theta_sites_repr
#
# D8 compliant: zero `import tuningfork` in the inference path.
# blackjax.mcmc.laplace_marginal is part of the blackjax package, not tuningfork.
from blackjax.mcmc.laplace_marginal import laplace_marginal_factory as _lmf

_phi_sites = $phi_sites_repr
_theta_sites = $theta_sites_repr

# Save the joint logdensity_fn from preamble before overriding.
_joint_logdensity_fn = logdensity_fn

# Factored joint: log p(theta, phi | y) = _joint_logdensity_fn({**theta, **phi})
# This is the log_joint_fn expected by blackjax.laplace_hmc / laplace_mhmc etc.
def log_joint_fn(theta, phi):
    return _joint_logdensity_fn({**theta, **phi})


# Split the full initial position into phi and theta components.
# build_logdensity_fn() initialises all sites to prior mean (0 for log-scale params).
_full_init = init_position
theta_init = {k: _full_init[k] for k in _theta_sites}
phi_init = {k: _full_init[k] for k in _phi_sites}

# Override: warmup templates and sampler templates see phi-space only.
init_position = phi_init

# Build one LaplaceMarginal per warmup phase.
# LaplaceMarginal(phi[, theta_prev=None]) → (lp: float, theta_star: pytree)
#
# window_adaptation(blackjax.laplace_hmc, laplace, ...) uses the LaplaceMarginal as
# its logdensity_fn.  laplace_hmc.init(phi, laplace) calls:
#   jax.value_and_grad(laplace, has_aux=True)(phi)
# which requires the (lp, aux) return contract that LaplaceMarginal satisfies.
# (A plain phi→float marginal would fail here because has_aux=True expects a tuple.)
_laplace_warmup = [$laplace_factories_expr]

# Set logdensity_fn to phase 1 LaplaceMarginal — picked up by the first warmup template.
logdensity_fn = _laplace_warmup[0]
