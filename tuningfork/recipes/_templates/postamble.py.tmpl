# Print headline diagnostics for verification.
# Different sampler families have different Info namedtuples; we check what
# fields are available rather than hardcoding.  The postamble is a coarse gate
# (option-A from the round-trip CI design): emit a sampler-appropriate scalar
# summary + the DONE marker.
_acceptance = float("nan")
_n_div = 0
if hasattr(_infos, "is_divergent"):
    _n_div = int(jnp.sum(_infos.is_divergent))
if hasattr(_infos, "acceptance_rate"):
    _acceptance = float(jnp.mean(_infos.acceptance_rate))
elif hasattr(_infos, "is_accepted"):
    _acceptance = float(jnp.mean(_infos.is_accepted))

# Timing split: warmup vs sampling.
# jax.block_until_ready ensures async dispatch has completed before we stamp
# the sampling end time (JAX dispatches kernels asynchronously by default, so
# perf_counter() without a block would measure dispatch time, not wall time).
jax.block_until_ready(_samples)
_sampling_wall = _recipe_time.perf_counter() - _warmup_t1
_recipe_wall = _recipe_time.perf_counter() - _recipe_t0

# ---------------------------------------------------------------------------
# Persist draws as .npz — no external library dependency.
# ---------------------------------------------------------------------------
# _samples.position is a pytree dict[str, array(num_chains, num_samples, *shape)]
# for numpyro models.  We save the posterior arrays directly so users can load
# them with np.load() or pass them to arviz offline:
#   draws = np.load("...<recipe>.draws.npz")
#   az.from_dict({"posterior": {k: draws[k] for k in draws.files}})
try:
    _pos = _samples.position
    if isinstance(_pos, dict):
        _draws_dict = {k: np.asarray(v) for k, v in _pos.items()}
    else:
        # Fallback: ravel the pytree into named per-dimension keys.
        from jax.flatten_util import ravel_pytree as _ravel_pytree
        _flat_single, _ = _ravel_pytree(jax.tree.map(lambda x: x[0, 0], _pos))
        _n_params = int(_flat_single.shape[0])
        _flat_chains = np.stack(
            [
                np.stack(
                    [
                        np.asarray(_ravel_pytree(jax.tree.map(lambda x, c=_c, s=_s: x[c, s], _pos))[0])
                        for _s in range(_NUM_SAMPLES)
                    ]
                )
                for _c in range(num_chains)
            ]
        )  # shape (num_chains, num_samples, n_params)
        _draws_dict = {f"param_{_i}": _flat_chains[..., _i] for _i in range(_n_params)}
    # Optionally include per-step sample stats as extra keys (prefixed "_ss_").
    for _ss_field in ("is_divergent", "energy", "acceptance_rate", "num_integration_steps"):
        if hasattr(_infos, _ss_field):
            _draws_dict[f"_ss_{_ss_field}"] = np.asarray(getattr(_infos, _ss_field))
    _npz_path = "$model_name" + "__" + "$base_method_name" + "__" + "$warmup_name" + ".draws.npz"
    np.savez(_npz_path, **_draws_dict)
    print(f"[draws written to {_npz_path}]")
except Exception as _save_exc:
    print(
        f"[WARNING] draws persist failed — inference output is still valid; npz skipped. "
        f"Reason: {_save_exc}"
    )

print(
    f"[recipe='$recipe_id'] n_divergences={_n_div} mean_acceptance={_acceptance:.3f}"
    f" warmup_wall_seconds={_warmup_wall:.1f}"
    f" sampling_wall_seconds={_sampling_wall:.1f}"
    f" wall_seconds={_recipe_wall:.1f}"
)
# Naive scalar verdict signal -- sufficient for the round-trip CI gate.
print("DONE")
