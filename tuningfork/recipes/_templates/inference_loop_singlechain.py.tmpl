_NUM_SAMPLES = $num_samples
_SAMPLING_PROGRESS_BAR = True  # True = single-chain (safe with io_callback); set False for multi-chain run
# Single-chain sampling (progress_bar=True).
# progress_bar uses io_callback inside the scan body.  io_callback is not
# supported inside jax.vmap, so multi-chain sampling (scan(vmap(kernel)))
# cannot use a progress bar.  We sample a SINGLE chain with a plain
# run_inference_algorithm call, then re-add a leading axis of 1 so that
# downstream consumers see shape (1, num_samples, ...) regardless of
# the recipe's num_chains setting.
import warnings
warnings.warn(
    f"progress_bar=True samples a SINGLE chain only -- multi-chain sampling "
    f"runs under jax.vmap, which is incompatible with the progress bar's "
    f"io_callback and can deadlock on heavy models (see blackjax issue #927). "
    f"For the full {num_chains}-chain run, set progress_bar=False.",
    stacklevel=1,
)

# Ensure _state_post_warmup has a leading chain axis before extracting chain 0.
try:
    _warmup_init_is_single_chain
except NameError:
    _warmup_init_is_single_chain = False

if _warmup_init_is_single_chain:
    _state_post_warmup = jax.tree.map(
        lambda x: jnp.broadcast_to(x[None], (num_chains,) + x.shape),
        _state_post_warmup,
    )
    # Scalar defaults for no-warmup path (samplers that don't use IMM ignore these).
    _shared_step_size = float(_adapted_params.get("step_size", 1.0))
    from jax.flatten_util import ravel_pytree as _il_ravel
    _il_flat, _ = _il_ravel(init_position)
    _n_dims = int(_il_flat.shape[0])
    _shared_imm = jnp.ones(_n_dims)

# Shared adapted params (single-chain warmup).
try:
    _warmup_is_perchain
except NameError:
    _warmup_is_perchain = False

if not _warmup_is_perchain:
    _shared_step_size = _adapted_params["step_size"]
    _shared_imm = _adapted_params["inverse_mass_matrix"]

# Detect samplers that need a different state type (dynamic_hmc, dmhmc, ghmc).
try:
    _state_reinit
    _needs_state_reinit = True
except NameError:
    _needs_state_reinit = False

from blackjax.util import run_inference_algorithm as _run_inference_algorithm
from blackjax.base import SamplingAlgorithm as _SamplingAlgorithm

# Extract single-chain state (chain 0).
_single_chain_state = jax.tree.map(lambda x: x[0], _state_post_warmup)

# Re-init if required by this sampler family.
if _needs_state_reinit:
    _single_reinit_key = jax.random.key($tuning_seed + 998)
    _single_chain_state = _state_reinit(
        _shared_step_size, _shared_imm, _single_chain_state.position, _single_reinit_key
    )

# Build a single-chain step function using the shared adapted params.
_single_chain_step = kernel_builder(_shared_step_size, _shared_imm)
_sc_alg = _SamplingAlgorithm(lambda *args, **kwargs: None, _single_chain_step)

_sc_final_state, (_sc_states_hist, _sc_infos_hist) = _run_inference_algorithm(
    jax.random.key($sampler_seed),
    _sc_alg,
    num_steps=_NUM_SAMPLES,
    initial_state=_single_chain_state,
    progress_bar=True,
)

# Re-add the leading chain axis (size 1) for downstream shape consistency:
# (num_steps, ...) -> (1, num_samples, ...).
_samples = jax.tree.map(lambda x: x[None], _sc_states_hist)
_infos = jax.tree.map(lambda x: x[None], _sc_infos_hist)
